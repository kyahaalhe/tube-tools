# Main YouTube Data API v3 key (required)
YOUTUBE_API_KEY=AIzaSyBLjKR8uhIzFppHevx2loeNAO5EJsFaXkU

# Optional backup keys. They MUST belong to the SAME Google Cloud project as the main key
# (one quota is shared). They are used only when a key itself is broken (invalid, blocked, expired).
# A "quota exceeded" error never switches keys. Google forbids using several projects to get around quota.
#YOUTUBE_API_KEY_2=
#YOUTUBE_API_KEY_3=

# Optional: also send feedback from Tubi to a Discord (or Slack) webhook. Feedback is always written to the server log.
#FEEDBACK_WEBHOOK_URL=
